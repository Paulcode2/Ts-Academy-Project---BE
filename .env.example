NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/warehouse_management_dev?replicaSet=rs0
JWT_ACCESS_SECRET=replace_with_secure_access_secret_32_chars_or_more
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_32_chars_or_more
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@warehouse.local
ADMIN_PASSWORD=ChangeMeStrongPassword123!
